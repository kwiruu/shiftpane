{
  "name": "@shiftpane/desktop",
  "version": "0.7.0",
  "private": true,
  "description": "ShiftPane desktop app: pairing, HTTPS/WebSocket server, display capture, widget collectors",
  "author": "ShiftPane contributors",
  "homepage": "https://github.com/kwiruu/shiftpane",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && node scripts/ensure-helper.mjs && electron-vite dev",
    "build": "electron-vite build",
    "preview": "node scripts/ensure-electron.mjs && node scripts/ensure-helper.mjs && electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@shiftpane/board": "workspace:*",
    "@shiftpane/helper-client": "workspace:*",
    "@shiftpane/layout": "workspace:*",
    "@shiftpane/protocol": "workspace:*",
    "@shiftpane/ui": "workspace:*",
    "@shiftpane/widget-runtime": "workspace:*",
    "@shiftpane/widget-sdk": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "electron": "^44.7.1",
    "electron-builder": "^26.17.0",
    "electron-vite": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "selfsigned": "^5.5.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.22.0",
    "zod": "catalog:"
  }
}
