{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "repository": {
      "type": "string",
      "maxLength": 512,
      "format": "uri"
    },
    "categories": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "system",
          "dev",
          "productivity",
          "media",
          "finance",
          "weather",
          "fun",
          "other"
        ]
      }
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "sizes": {
      "minItems": 1,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "small",
          "medium",
          "large"
        ]
      }
    },
    "refreshSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "permissions": {
      "default": {
        "sources": [],
        "actions": [],
        "local": [],
        "network": [],
        "secrets": []
      },
      "type": "object",
      "properties": {
        "sources": {
          "default": [],
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "gpu",
              "network",
              "disks",
              "battery",
              "audio",
              "system",
              "temperatures",
              "media",
              "processes",
              "active-window"
            ]
          }
        },
        "actions": {
          "default": [],
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "media.play-pause",
              "media.next",
              "media.previous",
              "audio.set-volume",
              "audio.toggle-mute"
            ]
          }
        },
        "local": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 260,
            "pattern": "^(?:\\[[0-9a-fA-F:]+\\]|[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?):\\d{1,5}$"
          }
        },
        "network": {
          "default": [],
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^(\\*\\.)?([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        },
        "secrets": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "location"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "datetime"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "string"
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "select"
              },
              "options": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "options"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "version",
    "author",
    "license",
    "categories",
    "minAppVersion",
    "sizes"
  ],
  "additionalProperties": false,
  "title": "ShiftPane widget manifest"
}
