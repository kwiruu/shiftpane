{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "refreshSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "sizes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "small",
          "medium",
          "large"
        ]
      }
    },
    "permissions": {
      "default": {
        "network": [],
        "secrets": []
      },
      "type": "object",
      "properties": {
        "network": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^(\\*\\.)?([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        },
        "secrets": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "default": [],
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "string"
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "boolean"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "key",
              "label",
              "type"
            ]
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "help": {
                "type": "string",
                "maxLength": 256
              },
              "required": {
                "default": false,
                "type": "boolean"
              },
              "type": {
                "type": "string",
                "const": "select"
              },
              "options": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ]
                }
              },
              "default": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "label",
              "type",
              "options"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "author",
    "sizes"
  ],
  "additionalProperties": false,
  "title": "ShiftPane widget manifest"
}
